# ---------------------------------------------------------------------------
# Resume Tracker - environment variables
# Copy to `.env` (local) or paste into your host's env settings (Render, etc.).
# ---------------------------------------------------------------------------

# --- Database (Neon Postgres in production) ---
# Neon gives a URL like:
#   postgresql://user:pass@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require
# DATABASE_URL=postgresql://postgres:2023@db:5432/resume_tracker
DATABASE_URL=postgresql://neondb_owner:npg_pItPOw9D7Yyz@ep-shy-feather-aodd5109-pooler.c-2.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# --- Redis (Upstash in production; Celery broker + cache) ---
# Upstash gives a TLS URL like: rediss://default:xxxx@yyyy.upstash.io:6379
# REDIS_URL=redis://redis:6379/0
REDIS_URL=rediss://default:gQAAAAAAAbOfAAIgcDE5YzQwMjQxNTc1MWY0MjNiYWYzOWIzMGNiNzhlZDU5ZA@main-wallaby-111519.upstash.io:6379?ssl_cert_reqs=CERT_NONE
# NL-search cache TTL in seconds (optional)
NL_SEARCH_TTL=1800

# --- Encryption / auth secrets ---
# Fernet key used to encrypt/decrypt stored API keys (src/utils/helper.py).
# MUST match the key that encrypted the values in your imported DB dump,
# otherwise stored LLM API keys will fail to decrypt.
# Generate a new one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# JWT settings (src/auth/jwt.py)
JWT_SECRET_KEY=change-me-to-a-strong-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- File storage ---
# On free hosting this is ephemeral (lost on restart/redeploy).
ATTACHMENT_DIR=attachments

# --- Email (IMAP fallback reader) ---
IMAP_SERVER=imap.gmail.com
EMAIL_ACCOUNT=
PASSWORD=

# --- Gmail OAuth ---
GMAIL_AUTH_URL=https://accounts.google.com/o/oauth2/v2/auth
GMAIL_TOKEN_URL=https://oauth2.googleapis.com/token
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Set to your deployed URL callback, e.g. https://your-app.onrender.com/api/auth/gmail/callback
GMAIL_REDIRECT_URI=
GMAIL_LIST_URL=https://gmail.googleapis.com/gmail/v1/users/me/messages

# --- Zoho OAuth ---
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REDIRECT_URI=

# --- LLM (optional) ---
# Ollama is not used in production (LLM provider/keys come from the DB config,
# e.g. Groq). Left here only for local Ollama development.
OLLAMA_HOST=http://host.docker.internal:11434

# --- LangSmith tracing (optional; off by default) ---
LANGCHAIN_TRACING_V2=false
LANGCHAIN_PROJECT=resume-tracker
# LANGCHAIN_API_KEY=
